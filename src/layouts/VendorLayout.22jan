import React, { useState, useEffect } from "react"
import { Outlet, Link, useNavigate, useLocation } from "react-router-dom"
import { isVendorLoggedIn, getStoredVendor, logoutVendor } from "../utils/apiClient"

const VendorLayout = () => {
  const navigate = useNavigate()
  const location = useLocation()
  const [vendor, setVendor] = useState(null)
  const [sidebarOpen, setSidebarOpen] = useState(false)

  useEffect(() => {
    const vendorData = getStoredVendor()
    if (vendorData) {
      setVendor(vendorData)
    }
  }, [])

  const handleLogout = () => {
    logoutVendor()
    navigate("/fun-day/vendor/login")
  }

  const navItems = [
    {
      path: "/fun-day/vendor/dashboard",
      label: "Dashboard",
      icon: (
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
      ),
    },
    {
      path: "/fun-day/vendor/events/new",
      label: "Create Event",
      icon: (
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
      ),
    },
  ]

  const isActive = (path) => {
    return location.pathname === path
  }

  // Public routes (no sidebar needed)
  const publicRoutes = ["/fun-day/vendor/login", "/fun-day/vendor/register"]
  const isPublicRoute = publicRoutes.some((route) => location.pathname.startsWith(route))

  if (isPublicRoute) {
    return <Outlet />
  }

  return (
    <div style={{ display: "flex", minHeight: "100vh", backgroundColor: "#f3f4f6" }}>
      {/* Sidebar - Desktop */}
      <aside
        style={{
          width: "260px",
          backgroundColor: "#1e1b4b",
          color: "white",
          position: "fixed",
          height: "100vh",
          overflowY: "auto",
          display: "none",
          "@media (min-width: 768px)": {
            display: "block",
          },
        }}
        className="vendor-sidebar"
      >
        {/* Logo/Brand */}
        <div
          style={{
            padding: "24px 20px",
            borderBottom: "1px solid rgba(255,255,255,0.1)",
          }}
        >
          <h1 style={{ margin: 0, fontSize: "1.25rem", fontWeight: 700 }}>
            🎪 Fun Day
          </h1>
          <p style={{ margin: "4px 0 0", fontSize: "0.75rem", opacity: 0.7 }}>
            Vendor Portal
          </p>
        </div>

        {/* Navigation */}
        <nav style={{ padding: "16px 12px" }}>
          <ul style={{ listStyle: "none", margin: 0, padding: 0 }}>
            {navItems.map((item) => (
              <li key={item.path} style={{ marginBottom: "4px" }}>
                <Link
                  to={item.path}
                  style={{
                    display: "flex",
                    alignItems: "center",
                    gap: "12px",
                    padding: "12px 16px",
                    borderRadius: "8px",
                    color: isActive(item.path) ? "#ffffff" : "rgba(255,255,255,0.7)",
                    backgroundColor: isActive(item.path) ? "rgba(124, 58, 237, 0.3)" : "transparent",
                    textDecoration: "none",
                    fontSize: "0.9rem",
                    fontWeight: 500,
                    transition: "all 0.2s",
                  }}
                >
                  {item.icon}
                  {item.label}
                </Link>
              </li>
            ))}
          </ul>
        </nav>

        {/* Vendor Info */}
        {vendor && (
          <div
            style={{
              position: "absolute",
              bottom: 0,
              left: 0,
              right: 0,
              padding: "16px 20px",
              borderTop: "1px solid rgba(255,255,255,0.1)",
              backgroundColor: "rgba(0,0,0,0.2)",
            }}
          >
            <p style={{ margin: "0 0 4px", fontSize: "0.85rem", fontWeight: 600 }}>
              {vendor.company_name}
            </p>
            <p style={{ margin: "0 0 12px", fontSize: "0.75rem", opacity: 0.7 }}>
              {vendor.email}
            </p>
            <button
              onClick={handleLogout}
              style={{
                width: "100%",
                padding: "10px",
                backgroundColor: "rgba(239, 68, 68, 0.2)",
                border: "1px solid rgba(239, 68, 68, 0.5)",
                borderRadius: "6px",
                color: "#fca5a5",
                fontSize: "0.85rem",
                fontWeight: 500,
                cursor: "pointer",
                transition: "all 0.2s",
              }}
            >
              Sign Out
            </button>
          </div>
        )}
      </aside>

      {/* Mobile Sidebar Overlay */}
      {sidebarOpen && (
        <div
          onClick={() => setSidebarOpen(false)}
          style={{
            position: "fixed",
            top: 0,
            left: 0,
            right: 0,
            bottom: 0,
            backgroundColor: "rgba(0,0,0,0.5)",
            zIndex: 40,
            display: "block",
            "@media (min-width: 768px)": {
              display: "none",
            },
          }}
          className="mobile-overlay"
        />
      )}

      {/* Mobile Sidebar */}
      <aside
        style={{
          position: "fixed",
          top: 0,
          left: sidebarOpen ? "0" : "-280px",
          width: "260px",
          height: "100vh",
          backgroundColor: "#1e1b4b",
          color: "white",
          zIndex: 50,
          transition: "left 0.3s ease",
          display: "block",
          "@media (min-width: 768px)": {
            display: "none",
          },
        }}
        className="mobile-sidebar"
      >
        {/* Logo/Brand */}
        <div
          style={{
            padding: "24px 20px",
            borderBottom: "1px solid rgba(255,255,255,0.1)",
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <div>
            <h1 style={{ margin: 0, fontSize: "1.25rem", fontWeight: 700 }}>
              🎪 Fun Day
            </h1>
            <p style={{ margin: "4px 0 0", fontSize: "0.75rem", opacity: 0.7 }}>
              Vendor Portal
            </p>
          </div>
          <button
            onClick={() => setSidebarOpen(false)}
            style={{
              background: "none",
              border: "none",
              color: "white",
              fontSize: "1.5rem",
              cursor: "pointer",
            }}
          >
            ×
          </button>
        </div>

        {/* Navigation */}
        <nav style={{ padding: "16px 12px" }}>
          <ul style={{ listStyle: "none", margin: 0, padding: 0 }}>
            {navItems.map((item) => (
              <li key={item.path} style={{ marginBottom: "4px" }}>
                <Link
                  to={item.path}
                  onClick={() => setSidebarOpen(false)}
                  style={{
                    display: "flex",
                    alignItems: "center",
                    gap: "12px",
                    padding: "12px 16px",
                    borderRadius: "8px",
                    color: isActive(item.path) ? "#ffffff" : "rgba(255,255,255,0.7)",
                    backgroundColor: isActive(item.path) ? "rgba(124, 58, 237, 0.3)" : "transparent",
                    textDecoration: "none",
                    fontSize: "0.9rem",
                    fontWeight: 500,
                    transition: "all 0.2s",
                  }}
                >
                  {item.icon}
                  {item.label}
                </Link>
              </li>
            ))}
          </ul>
        </nav>

        {/* Vendor Info */}
        {vendor && (
          <div
            style={{
              position: "absolute",
              bottom: 0,
              left: 0,
              right: 0,
              padding: "16px 20px",
              borderTop: "1px solid rgba(255,255,255,0.1)",
              backgroundColor: "rgba(0,0,0,0.2)",
            }}
          >
            <p style={{ margin: "0 0 4px", fontSize: "0.85rem", fontWeight: 600 }}>
              {vendor.company_name}
            </p>
            <p style={{ margin: "0 0 12px", fontSize: "0.75rem", opacity: 0.7 }}>
              {vendor.email}
            </p>
            <button
              onClick={handleLogout}
              style={{
                width: "100%",
                padding: "10px",
                backgroundColor: "rgba(239, 68, 68, 0.2)",
                border: "1px solid rgba(239, 68, 68, 0.5)",
                borderRadius: "6px",
                color: "#fca5a5",
                fontSize: "0.85rem",
                fontWeight: 500,
                cursor: "pointer",
              }}
            >
              Sign Out
            </button>
          </div>
        )}
      </aside>

      {/* Main Content */}
      <main
        style={{
          flex: 1,
          marginLeft: "0",
          "@media (min-width: 768px)": {
            marginLeft: "260px",
          },
        }}
        className="main-content"
      >
        {/* Mobile Header */}
        <header
          style={{
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            padding: "16px 20px",
            backgroundColor: "white",
            borderBottom: "1px solid #e5e7eb",
            position: "sticky",
            top: 0,
            zIndex: 30,
          }}
          className="mobile-header"
        >
          <button
            onClick={() => setSidebarOpen(true)}
            style={{
              display: "block",
              background: "none",
              border: "none",
              padding: "8px",
              "@media (min-width: 768px)": {
                display: "none",
              },
            }}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>

          <h1
            style={{
              margin: 0,
              fontSize: "1.1rem",
              fontWeight: 600,
              color: "#1e1b4b",
              display: "none",
              "@media (min-width: 768px)": {
                display: "block",
              },
            }}
            className="desktop-title"
          >
            🎪 Fun Day Vendor Portal
          </h1>

          <div style={{ display: "flex", alignItems: "center", gap: "12px" }}>
            {vendor && (
              <span style={{ fontSize: "0.85rem", color: "#64748b" }}>
                {vendor.company_name}
              </span>
            )}
          </div>
        </header>

        {/* Page Content */}
        <div style={{ padding: "24px 20px" }}>
          <Outlet />
        </div>
      </main>

      {/* CSS for responsive behavior */}
      <style>{`
        @media (min-width: 768px) {
          .vendor-sidebar {
            display: block !important;
          }
          .mobile-sidebar,
          .mobile-overlay,
          .mobile-header {
            display: none !important;
          }
          .main-content {
            margin-left: 260px !important;
          }
          .desktop-title {
            display: block !important;
          }
        }
      `}</style>
    </div>
  )
}

export default VendorLayout
